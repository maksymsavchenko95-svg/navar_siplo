{
  "name": "@navar/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./router": {
      "types": "./src/trpc/router.ts",
      "default": "./src/trpc/router.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "mcp:auth": "tsx src/scripts/mcp-auth.ts",
    "mcp:tools-snapshot": "tsx src/scripts/mcp-tools-snapshot.ts",
    "mcp:audit": "tsx src/scripts/mcp-audit.ts",
    "mcp:audit:cart": "tsx src/scripts/mcp-audit-cart.ts",
    "mapper:probe": "tsx src/scripts/mapper-probe.ts",
    "plan:probe": "tsx src/scripts/plan-probe.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@navar/db": "workspace:*",
    "@navar/domain": "workspace:*",
    "@navar/llm": "workspace:*",
    "@navar/mapper": "workspace:*",
    "@navar/planner": "workspace:*",
    "@navar/retail": "workspace:*",
    "@navar/safety": "workspace:*",
    "@trpc/server": "^11.0.0",
    "bullmq": "^6.3.4",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.2.0",
    "ioredis": "^5.11.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
