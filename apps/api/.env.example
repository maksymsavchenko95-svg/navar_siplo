# Copy to apps/api/.env for host runs (seed, mcp:auth, or the API on the host).
# docker-compose injects its own values for the containerised api service.

API_PORT=3001
DATABASE_URL=postgres://navar:navar@localhost:5432/navar
REDIS_URL=redis://localhost:6379
SILPO_MCP_URL=https://mcp.silpo.ua/mcp
MCP_OAUTH_CALLBACK_PORT=8765
# 32 random bytes, base64 — openssl rand -base64 32
MCP_TOKEN_KEY=

# --- Web auth / sessions (FR-AUTH-002) ---
PUBLIC_API_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
# Signs the session + pending-OAuth cookies. Optional for local dev (a weak default is used).
# Set for anything shared or deployed:  openssl rand -base64 32
# COOKIE_SECRET=
SILPO_OAUTH_CLIENT=

# --- LLM (@navar/llm) — absent key → deterministic fallbacks only ---
ANTHROPIC_API_KEY=
NAVAR_LLM_MODEL=claude-sonnet-5
# The mapper's SKU re-rank step only (T4.5) — a fast model; ~12–15 per plan.generate.
NAVAR_LLM_RERANK_MODEL=claude-haiku-4-5
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
