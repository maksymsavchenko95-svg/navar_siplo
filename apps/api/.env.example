# Copy to apps/api/.env for host runs (seed, mcp:auth, or the API on the host).
# docker-compose injects its own values for the containerised api service.

API_PORT=3001
DATABASE_URL=postgres://navar:navar@localhost:5432/navar
SILPO_MCP_URL=https://mcp.silpo.ua/mcp
MCP_OAUTH_CALLBACK_PORT=8765
# 32 random bytes, base64 — openssl rand -base64 32
MCP_TOKEN_KEY=
