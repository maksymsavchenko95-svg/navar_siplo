# Copy to .env on the VPS (repo root) and fill in real values.
# Consumed by `docker compose -f docker-compose.prod.yml up -d --build`.

# --- Database ---
# Change from the dev default before going live.
POSTGRES_PASSWORD=

# --- Silpo MCP ---
SILPO_MCP_URL=https://mcp.silpo.ua/mcp

# --- MCP token encryption (AES-256-GCM, tokens at rest in mcp_credentials) ---
# 32 random bytes, base64. Generate: openssl rand -base64 32
MCP_TOKEN_KEY=

# --- Web auth / sessions (FR-AUTH-002) ---
# navar.top -> web, api.navar.top -> API (same registrable domain keeps sameSite:"lax").
PUBLIC_API_URL=https://api.navar.top
WEB_ORIGIN=https://navar.top
# Signs the session + pending-OAuth cookies. Generate: openssl rand -base64 32
COOKIE_SECRET=
# Pinned Silpo DCR client JSON. Leave empty for the first `up -d --build`, then run
# `docker compose -f docker-compose.prod.yml exec api pnpm mcp:register`, paste the printed
# JSON here, and `docker compose -f docker-compose.prod.yml up -d api` to restart with it pinned.
SILPO_OAUTH_CLIENT=

# --- Web ---
# Baked into the client bundle at Docker build time (Next.js NEXT_PUBLIC_* semantics) —
# changing it after the fact needs a rebuild, not just a container restart.
NEXT_PUBLIC_API_URL=https://api.navar.top

# --- LLM (@navar/llm) ---
# Absent -> deterministic fallbacks only (degradation ladder), no LLM calls.
ANTHROPIC_API_KEY=
NAVAR_LLM_MODEL=claude-sonnet-5
NAVAR_LLM_RERANK_MODEL=claude-haiku-4-5

# --- LLM tracing (Langfuse, FR-OPS-002) — all three needed to activate ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
