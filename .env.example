# Copy to .env and fill in. .env is gitignored — never commit real values.
# Used by docker-compose and by host-run scripts.

# --- Database ---
# Host runs (drizzle-kit, seed, mcp:auth, API on host): use localhost.
# docker-compose overrides the api service with db:5432.
DATABASE_URL=postgres://navar:navar@localhost:5432/navar

# --- API ---
API_PORT=3001

# --- Silpo MCP ---
SILPO_MCP_URL=https://mcp.silpo.ua/mcp
# Loopback port the one-time `pnpm mcp:auth` flow listens on for the OAuth redirect.
MCP_OAUTH_CALLBACK_PORT=8765

# --- Redis / BullMQ (household.bootstrap job, T1.4) ---
# Host runs: localhost. docker-compose overrides the api service with redis:6379.
REDIS_URL=redis://localhost:6379

# --- MCP token encryption (AES-256-GCM, tokens at rest in mcp_credentials) ---
# 32 random bytes, base64. Generate: openssl rand -base64 32
MCP_TOKEN_KEY=

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- LLM (@navar/llm) ---
# Absent → the harness runs each step's deterministic fallback (degradation ladder).
ANTHROPIC_API_KEY=
NAVAR_LLM_MODEL=claude-haiku-4-5


# --- LLM tracing (Langfuse, FR-OPS-002) — all three needed to activate ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
